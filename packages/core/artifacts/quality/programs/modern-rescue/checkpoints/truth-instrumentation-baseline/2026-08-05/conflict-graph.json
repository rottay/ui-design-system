{
  "schemaVersion": 2,
  "roundId": "R0",
  "principle": "Parallelize independent ownership, not a number of agents.",
  "law": {
    "edgeWhen": [
      "lanes share a writable file",
      "lanes require the same reserved authority",
      "one lane consumes anatomy concurrently changed by another",
      "both lanes require the same generated or i18n artifact"
    ],
    "oneWriterPerFilePerCohort": true,
    "singletonIntegrators": ["architecture-integrator", "quality-integrator"],
    "reviewersNeverWriteWhatTheyReview": true,
    "recalculatedAfterEveryIntegratorBatch": true
  },
  "roundScopeNote": "rounds/index.json R0 scope is 'quality tooling and contracts only; no broad family styling'. There are therefore NO family-writer lanes in R0 — every write lane is integrator-class or owns the showroom reference lab, which is outside reservedPaths.",
  "activeCohort": 2,
  "cohorts": {
    "1": "read-only scouts — nine lanes, fully parallel, zero writes",
    "2": "showroom lab extraction (frame, then two disjoint section lanes) in parallel with the architecture integrator and the quality integrator",
    "3": "lab dispatcher and scene routes, then first-paint authority, then the icon drain — serialized on page.tsx and on the section files"
  },
  "nodes": [
    {
      "lane": "SC-*",
      "laneClass": "scout",
      "cohort": 1,
      "model": "fable for architecture scouts, sonnet for census scouts",
      "readSet": ["repository"],
