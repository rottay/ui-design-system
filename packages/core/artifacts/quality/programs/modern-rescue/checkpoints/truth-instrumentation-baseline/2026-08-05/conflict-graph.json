  "edges": [
    {
      "from": "W-LAB-FRAME",
      "to": "W-LAB-SEC-A",
      "reason": "both read the monolith while it is being drained; the frame must land before sections bind to its context"
    },
    {
      "from": "W-LAB-FRAME",
      "to": "W-LAB-SEC-B",
      "reason": "ck-h1 and ck-e bind to useTortureFrame, which the frame must export first"
    },
    {
      "from": "W-LAB-SEC-A",
      "to": "W-LAB-DISPATCH",
      "reason": "the dispatcher statically imports lane A's modules and cannot compile before they exist"
    },
    {
      "from": "W-LAB-SEC-B",
      "to": "W-LAB-DISPATCH",
      "reason": "the dispatcher statically imports lane B's modules and cannot compile before they exist"
    },
    {
      "from": "W-LAB-FRAME",
      "to": "W-LAB-DISPATCH",
      "reason": "the dispatcher renders TortureFrame and must delete the six chrome derivations the frame now owns"
    }
  ],
  "deferredLanesWithDeclaredEdges": [
    {
      "lane": "W-LAB-PAINT",
      "objective": "server first paint carries tenant authority on both the static and DB paths",
      "writeSetOverlap": "packages/showroom/src/app/probe/whitelabel-torture/page.tsx",
      "edgeTo": "W-LAB-DISPATCH",
      "scheduling": "STRICTLY SEQUENTIAL after the dispatcher lands — the two lanes write the same file and may never run concurrently"
    },
    {
      "lane": "W-LAB-ICONS",
      "objective": "drain the lab's 33 placeholder icon call sites to semantic roles",
      "writeSetOverlap": "the 28 section modules",
      "edgeTo": ["W-LAB-SEC-A", "W-LAB-SEC-B"],
      "scheduling": "after both section lanes land. The 33 sites partition cleanly across 6 gated sections (fieldfilters 1, nav 12, display1 1, headers 4, dashboard 13, workspace 2), so the drain itself can then run as six single-owner parallel lanes."
    }
  ],
  "safetyVerification": {
    "command": "node packages/core/scripts/quality-evidence/v2/cli.mjs conflict-graph <this file>",
    "checks": [
      "no file appears in two lanes' writeSet",
      "no singleton integrator class is claimed by two lanes",
      "no reviewer lane declares a write set",
      "every write/write and write/read overlap has a declared edge"
    ]
