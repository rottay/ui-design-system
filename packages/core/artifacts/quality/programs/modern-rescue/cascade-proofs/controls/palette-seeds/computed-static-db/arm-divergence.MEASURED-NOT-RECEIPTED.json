  "divergenceClasses": [
    {
      "id": "MODE_BLOCK_SPECIFICITY",
      "where": "every dark row in both verticals (bithire 7, evnto 4)",
      "measured": "Each vertical artifact declares --ds-color-primary TWICE: once at :is(html[data-tenant=X], :where([data-ds-root][data-vertical=X])) and once at that SAME selector plus [data-theme=dark] (rottay: .light). The mode block carries one extra attribute, so it outranks the static arm block by SPECIFICITY regardless of source order — the static arm appends after the bundle and still loses. The DB arm writes inline on the document element and is not outranked.",
      "consequence": "The static arm is structurally inert, in dark, for every channel the artifact re-declares per mode. This is an instance of the already-registered OPEN_VERTICAL_CASCADE_DEFECT class (the bithire dark double declaration is the sibling instance), not a new class."
    },
    {
      "id": "COMPILERS_DISAGREE_ON_BUTTON_PRIMARY_BG",
      "where": "the three bithire LIGHT rows",
      "measured": "The two compilers emit DIFFERENT values for --ds-button-primary-bg on bithire: the static arm lowers the baked chrome hex #3A6FB0 (bithire authors chrome.controls.buttonPrimary.bg), the DB arm lowers the alias var(--ds-color-primary). The alias tracks the seed; the baked hex does not.",
      "consequence": "On evnto both arms emit the alias, so evnto has no light divergence. The channel is in declaredOutputs and was already flagged at design time as unusable as a witness; this measures WHY."
    }
  ],
  "whatHolds": "Restore is EXACT on both arms in every scenario, the negative controls held, and both arms are demonstrably live (harness-live) on bithire and evnto. What fails is equivalence, and only equivalence.",
  "reproduction": "node src/tooling/resolution-probe/public/cli/index.mjs causal --control-manifest manifest/controls/palette.seeds.json --family-manifest manifest/families/primitive/inputs/button.json --stop primary/crimson --vertical bithire --theme light --theme dark --bundle fresh --source-digest <observed>"
}
