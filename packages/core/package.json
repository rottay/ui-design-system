{
  "name": "@rottay/design-system",
  "version": "2.4.4",
  "description": "Multi-tenant, multi-engine design system with classic, modern, rustic, and experimental Athena engines",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js",
      "require": "./dist/tokens.cjs"
    },
    "./tokens/css": "./src/tokens/css/index.css",
    "./tokens/css/*": "./src/tokens/css/*",
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.js",
      "require": "./dist/i18n.cjs"
    },
    "./styles": "./src/tokens/css/index.css",
    "./styles.css": "./src/tokens/css/index.css",
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js",
      "require": "./dist/icons.cjs"
    },
    "./engines/classic": {
      "types": "./dist/engines/classic.d.ts",
      "import": "./dist/engines/classic.js"
    },
    "./engines/modern": {
      "types": "./dist/engines/modern.d.ts",
      "import": "./dist/engines/modern.js"
    },
    "./engines/rustic": {
      "types": "./dist/engines/rustic.d.ts",
      "import": "./dist/engines/rustic.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.cjs",
    "dist/**/*.d.ts",
    "!dist/**/*.d.ts.map",
    "src/tokens/css",
    "README.md"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "analyze": "node scripts/analyze-bundle.mjs",
    "analyze:skip-build": "node scripts/analyze-bundle.mjs --skip-build"
  },
  "peerDependencies": {
    "@ant-design/icons": "^5.5.0",
    "antd": "^5.21.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@heroui/react": "^2.8.5",
    "d3": "^7.9.0",
    "dayjs": "^1.11.19",
    "framer-motion": "^12.0.0",
    "geist": "^1.3.0",
    "lucide-react": "^0.545.0"
  },
  "devDependencies": {
    "@rottay/ia-chat": "link:../../../dm-ia-chat",
    "@rottay/recruiter": "link:../../../dm-recruiter",
    "@rottay/scoring": "link:../../../dm-scoring",
    "@storybook/addon-a11y": "^9.1.10",
    "@storybook/addon-docs": "^9.1.10",
    "@storybook/addon-onboarding": "^9.1.10",
    "@storybook/react-vite": "^9.1.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^20.19.27",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "daisyui": "^5.3.0",
    "happy-dom": "^20.0.0",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "storybook": "^9.1.10",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.2",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rottay/design-system.git"
  },
  "keywords": [
    "design-system",
    "react",
    "antd",
    "theme",
    "ui-components"
  ],
  "author": "Emmanuel Rottay",
  "license": "MIT"
}
