{
  "name": "@rottay/design-system",
  "version": "2.8.15",
  "description": "Multi-tenant, multi-engine design system with Ant Design, DaisyUI, and pure HTML engines",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css",
    "styles/**/*.css",
    "dist/**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js",
      "require": "./dist/icons.cjs"
    },
    "./styles": {
      "style": "./dist/styles.css",
      "import": "./dist/styles.css",
      "default": "./dist/styles.css"
    },
    "./styles.css": {
      "style": "./dist/styles.css",
      "import": "./dist/styles.css",
      "default": "./dist/styles.css"
    },
    "./styles/platform": {
      "style": "./dist/platform.css",
      "import": "./dist/platform.css",
      "default": "./dist/platform.css"
    },
    "./styles/bithire": {
      "style": "./dist/bithire.css",
      "import": "./dist/bithire.css",
      "default": "./dist/bithire.css"
    },
    "./styles/evnto": {
      "style": "./dist/evnto.css",
      "import": "./dist/evnto.css",
      "default": "./dist/evnto.css"
    },
    "./styles/rottay": {
      "style": "./dist/platform.css",
      "import": "./dist/platform.css",
      "default": "./dist/platform.css"
    },
    "./styles/modern": {
      "style": "./dist/modern-engine.css",
      "import": "./dist/modern-engine.css",
      "default": "./dist/modern-engine.css"
    },
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "import": "./dist/eslint.js",
      "require": "./dist/eslint.cjs"
    },
    "./dist/*.css": "./dist/*.css"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.cjs",
    "dist/**/*.d.ts",
    "dist/styles.css",
    "dist/modern-engine.css",
    "dist/platform.css",
    "dist/bithire.css",
    "dist/evnto.css",
    "styles/**/*.css",
    "!dist/**/*.d.ts.map",
    "README.md"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc && vite build && pnpm run build:modern-css && pnpm run build:vertical-css",
    "build:modern-css": "postcss src/tokens/css/engines/modern/compiled.css -o dist/modern-engine.css",
    "build:vertical-css": "node scripts/build-vertical-css.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build && node scripts/check-storybook-budget.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:ui": "vitest --ui",
    "test:coverage": "COVERAGE=1 vitest run --coverage",
    "test:ci": "COVERAGE=1 vitest run --coverage --reporter=verbose --reporter=json --outputFile.json=./test-results.json",
    "analyze": "node scripts/analyze-bundle.mjs",
    "analyze:skip-build": "node scripts/analyze-bundle.mjs --skip-build",
    "lint:folders": "node scripts/lint-folder-index.mjs",
    "lint:integration": "node scripts/audit-integration.mjs",
    "lint:vertical": "node scripts/audit-vertical-compliance.mjs",
    "docs:taxonomy": "node scripts/generate-taxonomy.mjs"
  },
  "releaseSync": {
    "gateCommands": {
      "test:unit": [
        {
          "label": "unit system/runtime/tokens",
          "pnpm": [
            "exec",
            "vitest",
            "run",
            "--project",
            "unit",
            "src/_internal",
            "src/hooks",
            "src/motion",
            "src/runtime",
            "src/tokens"
          ]
        },
        {
          "label": "unit components/patterns",
          "pnpm": [
            "exec",
            "vitest",
            "run",
            "--project",
            "unit",
            "src/components/patterns"
          ]
        },
        {
          "label": "unit components/primitives",
          "pnpm": [
            "exec",
            "vitest",
            "run",
            "--project",
            "unit",
            "src/components/primitives"
          ]
        },
        {
          "label": "unit surfaces/foundation-layout",
          "pnpm": [
            "exec",
            "vitest",
            "run",
            "--project",
            "unit",
            "src/components/surfaces/foundation/common/tests/builders.test.ts",
            "src/components/surfaces/foundation/common/tests/helpers.test.ts",
            "src/components/surfaces/foundation/tests/builders.test.ts",
            "src/components/surfaces/layout/header/tests/HeaderSurface.test.tsx",
            "src/components/surfaces/layout/sidebar/tests/SidebarSurface.test.tsx"
          ]
        },
        {
          "label": "unit surfaces/admin",
          "pnpm": [
            "exec",
            "vitest",
            "run",
            "--project",
            "unit",
            "src/components/surfaces/pages/admin"
          ]
        },
        {
          "label": "unit surfaces/data",
          "pnpm": [
            "exec",
            "vitest",
            "run",
            "--project",
            "unit",
            "src/components/surfaces/pages/data"
          ]
        },
        {
          "label": "unit surfaces/experience",
          "pnpm": [
            "exec",
            "vitest",
            "run",
            "--project",
            "unit",
            "src/components/surfaces/pages/experience"
          ]
        },
        {
          "label": "unit surfaces/forms",
          "pnpm": [
            "exec",
            "vitest",
            "run",
            "--project",
            "unit",
            "src/components/surfaces/pages/forms"
          ]
        },
        {
          "label": "unit surfaces/operations",
          "pnpm": [
            "exec",
            "vitest",
            "run",
            "--project",
            "unit",
            "src/components/surfaces/pages/operations"
          ]
        },
        {
          "label": "unit surfaces/workspace",
          "pnpm": [
            "exec",
            "vitest",
            "run",
            "--project",
            "unit",
            "src/components/surfaces/pages/workspace"
          ]
        }
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@ant-design/icons": "^5.5.0",
    "@heroui/react": "^2.8.5",
    "antd": "^5.21.0",
    "d3": "^7.9.0",
    "framer-motion": "^12.0.0",
    "geist": "^1.3.0",
    "lucide-react": ">=0.545.0 <1.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@heroui/react": {
      "optional": true
    },
    "d3": {
      "optional": true
    },
    "framer-motion": {
      "optional": true
    },
    "geist": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    }
  },
  "dependencies": {
    "dayjs": "^1.11.20"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/addon-onboarding": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.5.0",
    "daisyui": "^5.5.19",
    "happy-dom": "^20.9.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.10",
    "postcss-cli": "^11.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "storybook": "^9.1.20",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rottay/design-system.git"
  },
  "keywords": [
    "design-system",
    "react",
    "antd",
    "theme",
    "ui-components"
  ],
  "author": "Daniel Avila <daniel.avila@rottay.com>",
  "license": "UNLICENSED"
}
