{
  "name": "@rottay/design-system",
  "version": "2.19.34",
  "description": "Multi-tenant, multi-engine design system with token-driven skins and white-label runtime theming",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "rottay-ds-supplier-honesty": "consumer/ds-supplier-honesty.mjs"
  },
  "sideEffects": [
    "*.css",
    "styles/**/*.css",
    "dist/**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js",
      "require": "./dist/icons.cjs"
    },
    "./icons/full": {
      "types": "./dist/icons-full.d.ts",
      "import": "./dist/icons-full.js",
      "require": "./dist/icons-full.cjs"
    },
    "./icons/presets/bithire": {
      "types": "./dist/icons-preset-bithire.d.ts",
      "import": "./dist/icons-preset-bithire.js",
      "require": "./dist/icons-preset-bithire.cjs"
    },
    "./icons/roles/*": {
      "types": "./dist/graphics/icons/presentation/semantic/generated/roles/*.d.ts",
      "import": "./dist/graphics/icons/presentation/semantic/generated/roles/*.js",
      "require": "./dist/graphics/icons/presentation/semantic/generated/roles/*.cjs"
    },
    "./icons/corpus": {
      "types": "./dist/icons-corpus.d.ts",
      "import": "./dist/icons-corpus.js",
      "require": "./dist/icons-corpus.cjs"
    },
    "./icons/foundation": {
      "types": "./dist/icons-foundation.d.ts",
      "import": "./dist/icons-foundation.js",
      "require": "./dist/icons-foundation.cjs"
    },
    "./icons/bithire": {
      "types": "./dist/icons-bithire.d.ts",
      "import": "./dist/icons-bithire.js",
      "require": "./dist/icons-bithire.cjs"
    },
    "./icons/identity": {
      "types": "./dist/icons-identity.d.ts",
      "import": "./dist/icons-identity.js",
      "require": "./dist/icons-identity.cjs"
    },
    "./icons/intelligence": {
      "types": "./dist/icons-intelligence.d.ts",
      "import": "./dist/icons-intelligence.js",
      "require": "./dist/icons-intelligence.cjs"
    },
    "./icons/operations": {
      "types": "./dist/icons-operations.d.ts",
      "import": "./dist/icons-operations.js",
      "require": "./dist/icons-operations.cjs"
    },
    "./marks": {
      "types": "./dist/marks.d.ts",
      "import": "./dist/marks.js",
      "require": "./dist/marks.cjs"
    },
    "./marks/brand": {
      "types": "./dist/marks-brand.d.ts",
      "import": "./dist/marks-brand.js",
      "require": "./dist/marks-brand.cjs"
    },
    "./marks/cloud": {
      "types": "./dist/marks-cloud.d.ts",
      "import": "./dist/marks-cloud.js",
      "require": "./dist/marks-cloud.cjs"
    },
    "./pictograms": {
      "types": "./dist/pictograms.d.ts",
      "import": "./dist/pictograms.js",
      "require": "./dist/pictograms.cjs"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js",
      "require": "./dist/charts.cjs"
    },
    "./charts/spec": {
      "types": "./dist/chart-spec.d.ts",
      "import": "./dist/chart-spec.js",
      "require": "./dist/chart-spec.cjs"
    },
    "./charts/access": {
      "types": "./dist/chart-access.d.ts",
      "import": "./dist/chart-access.js",
      "require": "./dist/chart-access.cjs"
    },
    "./charts/renderers": {
      "types": "./dist/chart-renderers.d.ts",
      "import": "./dist/chart-renderers.js",
      "require": "./dist/chart-renderers.cjs"
    },
    "./motion": {
      "types": "./dist/motion.d.ts",
      "import": "./dist/motion.js",
      "require": "./dist/motion.cjs"
    },
    "./effects": {
      "types": "./dist/effects.d.ts",
      "import": "./dist/effects.js",
      "require": "./dist/effects.cjs"
    },
    "./spatial": {
      "types": "./dist/spatial.d.ts",
      "import": "./dist/spatial.js",
      "require": "./dist/spatial.cjs"
    },
    "./spatial/spec": {
      "types": "./dist/spatial-spec.d.ts",
      "import": "./dist/spatial-spec.js",
      "require": "./dist/spatial-spec.cjs"
    },
    "./styles": {
      "style": "./dist/styles.css",
      "import": "./dist/styles.css",
      "default": "./dist/styles.css"
    },
    "./styles.css": {
      "style": "./dist/styles.css",
      "import": "./dist/styles.css",
      "default": "./dist/styles.css"
    },
    "./styles/platform": {
      "style": "./dist/platform.css",
      "import": "./dist/platform.css",
      "default": "./dist/platform.css"
    },
    "./styles/bithire": {
      "style": "./dist/bithire.css",
      "import": "./dist/bithire.css",
      "default": "./dist/bithire.css"
    },
    "./styles/evnto": {
      "style": "./dist/evnto.css",
      "import": "./dist/evnto.css",
      "default": "./dist/evnto.css"
    },
    "./styles/rottay": {
      "style": "./dist/platform.css",
      "import": "./dist/platform.css",
      "default": "./dist/platform.css"
    },
    "./styles/modern": {
      "style": "./dist/modern-engine.css",
      "import": "./dist/modern-engine.css",
      "default": "./dist/modern-engine.css"
    },
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "import": "./dist/eslint.js",
      "require": "./dist/eslint.cjs"
    },
    "./commercial": {
      "types": "./dist/commercial.d.ts",
      "import": "./dist/commercial.js",
      "require": "./dist/commercial.cjs"
    },
    "./supplier-contract": {
      "default": "./supplier-contract.json"
    },
    "./supplier-honesty-cli": {
      "import": "./consumer/ds-supplier-honesty.mjs",
      "default": "./consumer/ds-supplier-honesty.mjs"
    },
    "./commercial.css": {
      "style": "./dist/commercial.css",
      "import": "./dist/commercial.css",
      "default": "./dist/commercial.css"
    },
    "./dist/*.css": "./dist/*.css"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.cjs",
    "dist/**/*.d.ts",
    "dist/styles.css",
    "dist/modern-engine.css",
    "dist/commercial.css",
    "dist/platform.css",
    "dist/bithire.css",
    "dist/evnto.css",
    "supplier-contract.json",
    "consumer/ds-supplier-honesty.mjs",
    "THIRD_PARTY_NOTICES.md",
    "provenance/graphics/**",
    "styles/**/*.css",
    "!dist/**/*.d.ts.map",
    "README.md"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "icons:generate": "node scripts/generate-semantic-icons.mjs",
    "icons:check": "node scripts/generate-semantic-icons.mjs --check",
    "prebuild": "pnpm run cra17:licenses && pnpm run icons:check",
    "prepack": "pnpm run cra15:gate && pnpm run cra17:licenses && pnpm run cra17:declarations",
    "build": "tsc && vite build && pnpm run build:modern-css && pnpm run build:commercial-css && pnpm run build:vertical-css",
    "postbuild": "pnpm run cra14:check",
    "build:modern-css": "postcss src/foundation/tokens/css/runtime/engines/modern/compiled.css -o dist/modern-engine.css",
    "build:commercial-css": "node scripts/build-commercial-css.mjs",
    "engine-audit:check": "node scripts/engine-token-audit.mjs --check",
    "engine-audit:relocate-paths": "node scripts/relocate-engine-token-baseline.mjs",
    "cra14:check": "node scripts/cra-14-public-barrel-gate.mjs",
    "cra15:gate": "node scripts/cra-15-runtime-hardening-gate.mjs --check",
    "cra15:write": "node scripts/cra-15-runtime-hardening-gate.mjs --write",
    "cra17:licenses": "node scripts/cra-17-packaging-license-gate.mjs",
    "cra17:declarations": "node scripts/cra-17-public-declaration-gate.mjs",
    "cra11:generate": "node scripts/cra-11-adaptive-contract-census.mjs",
    "cra11:check": "node scripts/cra-11-adaptive-contract-census.mjs --check",
    "cra11:gate": "node scripts/cra-11-adaptive-contract-census.mjs --check --require-clean",
    "cra11:test": "node --test scripts/cra-11-adaptive-contract-census.test.mjs",
    "gat07:check": "node scripts/gat-07-exact-proof.mjs --check-artifact",
    "gat07:write": "node scripts/gat-07-exact-proof.mjs --write",
    "test:scripts": "node --test scripts/*.test.mjs && node --test ../../scripts/effect-registry-audit.test.mjs && vitest run --config scripts/vitest.scripts.config.ts",
    "pretest": "pnpm run cra17:licenses && pnpm run effects:provenance && node scripts/engine-token-audit.mjs --check && node scripts/build-vertical-artifacts.mjs --check && node scripts/build-vertical-css.mjs --check",
    "build:vertical-artifacts": "node scripts/build-vertical-artifacts.mjs",
    "build:vertical-css": "node scripts/build-vertical-artifacts.mjs && node scripts/build-vertical-css.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build && node scripts/check-storybook-budget.mjs",
    "pretypecheck": "pnpm run icons:check",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:ui": "vitest --ui",
    "test:coverage": "COVERAGE=1 vitest run --coverage",
    "test:ci": "COVERAGE=1 vitest run --coverage --reporter=verbose --reporter=json --outputFile.json=./test-results.json",
    "analyze": "node scripts/analyze-bundle.mjs",
    "analyze:skip-build": "node scripts/analyze-bundle.mjs --skip-build",
    "analyze:components": "node scripts/analyze-bundle.mjs --components",
    "analyze:chart-access": "node scripts/analyze-bundle.mjs --chart-access",
    "analyze:chart-spec": "node scripts/analyze-bundle.mjs --chart-spec",
    "analyze:effects": "node scripts/analyze-bundle.mjs --effects",
    "analyze:asset-retention": "node scripts/analyze-bundle.mjs --asset-retention",
    "effects:provenance": "node ../../scripts/effect-registry-audit.mjs",
    "lint": "pnpm run cra17:licenses && pnpm run effects:provenance && pnpm run lint:folders && pnpm run lint:integration && pnpm run lint:vertical && pnpm run lint:artifacts && node scripts/build-vertical-css.mjs --check",
    "lint:artifacts": "node scripts/build-vertical-artifacts.mjs --check",
    "lint:folders": "node scripts/lint-folder-index.mjs && node --test scripts/core-owner-boundaries.test.mjs && node scripts/core-structure-audit.mjs --check",
    "structure:check": "node --test scripts/core-owner-boundaries.test.mjs && node scripts/core-structure-audit.mjs --check",
    "structure:report": "node scripts/core-structure-audit.mjs --report",
    "lint:integration": "node scripts/audit-integration.mjs",
    "lint:vertical": "node scripts/audit-vertical-compliance.mjs",
    "docs:taxonomy": "node scripts/generate-taxonomy.mjs"
  },
  "releaseSync": {
    "sourceEntrypoints": {
      "./server": "entrypoints/server/index.ts",
      "./icons": "entrypoints/icons/index.ts",
      "./icons/full": "entrypoints/icons/full/index.ts",
      "./icons/presets/bithire": "entrypoints/icons/presets/bithire/index.ts",
      "./icons/corpus": "entrypoints/icons/corpus/index.ts",
      "./icons/foundation": "entrypoints/icons/foundation/index.ts",
      "./icons/bithire": "entrypoints/icons/bithire/index.ts",
      "./icons/identity": "entrypoints/icons/identity/index.ts",
      "./icons/intelligence": "entrypoints/icons/intelligence/index.ts",
      "./icons/operations": "entrypoints/icons/operations/index.ts",
      "./marks": "entrypoints/graphics/marks/index.ts",
      "./marks/brand": "entrypoints/graphics/marks/brand/index.ts",
      "./marks/cloud": "entrypoints/graphics/marks/cloud/index.ts",
      "./pictograms": "entrypoints/graphics/pictograms/index.ts",
      "./charts": "entrypoints/charts/index.ts",
      "./charts/spec": "entrypoints/charts/spec/index.ts",
      "./charts/access": "entrypoints/charts/access/index.ts",
      "./charts/renderers": "entrypoints/charts/renderers/index.ts",
      "./motion": "entrypoints/graphics/motion/index.ts",
      "./effects": "entrypoints/graphics/effects/index.ts",
      "./spatial": "entrypoints/graphics/spatial/index.ts",
      "./spatial/spec": "entrypoints/graphics/spatial/spec/index.ts",
      "./eslint": "entrypoints/eslint/index.ts",
      "./commercial": "entrypoints/commercial/index.ts"
    },
    "gateCommands": {
      "test:unit": [
        {
          "label": "unit system/runtime/tokens",
          "pnpm": [
            "exec",
            "vitest",
            "run",
            "--project",
            "unit",
            "src/foundation/kernel",
            "src/tooling/testing",
            "src/graphics/motion",
            "src/infrastructure/runtime",
            "src/foundation/tokens"
          ]
        },
        {
          "label": "unit components/patterns",
          "pnpm": [
            "exec",
            "vitest",
            "run",
            "--project",
            "unit",
            "src/ui/patterns"
          ]
        },
        {
          "label": "unit components/primitives",
          "pnpm": [
            "exec",
            "vitest",
            "run",
            "--project",
            "unit",
            "src/ui/primitives"
          ]
        },
        {
          "label": "unit surfaces/foundation-runtime-composition",
          "pnpm": [
            "exec",
            "vitest",
            "run",
            "--project",
            "unit",
            "src/ui/surfaces/foundation",
            "src/ui/surfaces/runtime",
            "src/ui/surfaces/composition",
            "src/ui/surfaces/tests"
          ]
        },
        {
          "label": "unit surfaces/admin",
          "pnpm": [
            "exec",
            "vitest",
            "run",
            "--project",
            "unit",
            "src/ui/surfaces/presentation/pages/admin"
          ]
        },
        {
          "label": "unit surfaces/data",
          "pnpm": [
            "exec",
            "vitest",
            "run",
            "--project",
            "unit",
            "src/ui/surfaces/presentation/pages/data"
          ]
        },
        {
          "label": "unit surfaces/experience",
          "pnpm": [
            "exec",
            "vitest",
            "run",
            "--project",
            "unit",
            "src/ui/surfaces/presentation/pages/experience"
          ]
        },
        {
          "label": "unit surfaces/forms",
          "pnpm": [
            "exec",
            "vitest",
            "run",
            "--project",
            "unit",
            "src/ui/surfaces/presentation/pages/forms"
          ]
        },
        {
          "label": "unit surfaces/operations",
          "pnpm": [
            "exec",
            "vitest",
            "run",
            "--project",
            "unit",
            "src/ui/surfaces/presentation/pages/operations"
          ]
        },
        {
          "label": "unit surfaces/workspace",
          "pnpm": [
            "exec",
            "vitest",
            "run",
            "--project",
            "unit",
            "src/ui/surfaces/presentation/pages/workspace"
          ]
        }
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
