{
  "name": "@rottay/design-system",
  "version": "2.6.19",
  "description": "Multi-tenant, multi-engine design system with Ant Design, DaisyUI, and pure HTML engines",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js",
      "require": "./dist/icons.cjs"
    },
    "./styles": {
      "style": "./dist/styles.css",
      "import": "./dist/styles.css",
      "default": "./dist/styles.css"
    },
    "./styles.css": {
      "style": "./dist/styles.css",
      "import": "./dist/styles.css",
      "default": "./dist/styles.css"
    },
    "./styles/platform": {
      "style": "./dist/platform.css",
      "import": "./dist/platform.css",
      "default": "./dist/platform.css"
    },
    "./styles/bithire": {
      "style": "./dist/bithire.css",
      "import": "./dist/bithire.css",
      "default": "./dist/bithire.css"
    },
    "./styles/evnto": {
      "style": "./dist/evnto.css",
      "import": "./dist/evnto.css",
      "default": "./dist/evnto.css"
    },
    "./styles/rottay": {
      "style": "./dist/platform.css",
      "import": "./dist/platform.css",
      "default": "./dist/platform.css"
    },
    "./styles/modern": {
      "style": "./dist/modern-engine.css",
      "import": "./dist/modern-engine.css",
      "default": "./dist/modern-engine.css"
    },
    "./dist/*.css": "./dist/*.css"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.cjs",
    "dist/**/*.d.ts",
    "dist/styles.css",
    "dist/modern-engine.css",
    "dist/platform.css",
    "dist/bithire.css",
    "dist/evnto.css",
    "!dist/**/*.d.ts.map",
    "README.md"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build && pnpm run build:modern-css && pnpm run build:vertical-css",
    "build:modern-css": "postcss src/tokens/css/engines/modern/compiled.css -o dist/modern-engine.css",
    "build:vertical-css": "node scripts/build-vertical-css.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build && node scripts/check-storybook-budget.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:ui": "vitest --ui",
    "test:coverage": "COVERAGE=1 vitest run --coverage",
    "test:ci": "COVERAGE=1 vitest run --coverage --reporter=verbose --reporter=json --outputFile.json=./test-results.json",
    "analyze": "node scripts/analyze-bundle.mjs",
    "analyze:skip-build": "node scripts/analyze-bundle.mjs --skip-build"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@ant-design/icons": "^5.5.0",
    "@heroui/react": "^2.8.5",
    "antd": "^5.21.0",
    "d3": "^7.9.0",
    "framer-motion": "^12.0.0",
    "geist": "^1.3.0",
    "lucide-react": "^0.545.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@heroui/react": {
      "optional": true
    },
    "d3": {
      "optional": true
    },
    "framer-motion": {
      "optional": true
    },
    "geist": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    }
  },
  "dependencies": {
    "dayjs": "^1.11.19"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^9.1.10",
    "@storybook/addon-docs": "^9.1.10",
    "@storybook/addon-onboarding": "^9.1.10",
    "@storybook/react-vite": "^9.1.10",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^20.19.27",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "daisyui": "^5.3.0",
    "happy-dom": "^20.0.0",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "storybook": "^9.1.10",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.2",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rottay/design-system.git"
  },
  "keywords": [
    "design-system",
    "react",
    "antd",
    "theme",
    "ui-components"
  ],
  "author": "Daniel Avila <daniel.avila@rottay.com>",
  "license": "UNLICENSED"
}
