    "react-dom": "^19.2.5",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "storybook": "^9.1.20",
    "tailwindcss": "^4.2.4",
    "thesvg": "3.2.6",
    "typescript": "^5.9.3",
