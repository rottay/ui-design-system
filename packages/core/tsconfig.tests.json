{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "rootDir": ".",
    // Declaration correction, not a capability widening: the suites run on a
    // Node/jsdom runtime that already ships the full ES2021 `Intl` surface
    // (`Intl.ListFormat`), while the inherited ES2020 `lib` under-reported it --
    // so a formatter test could exercise an API the checker denied existed.
    // Production stays on ES2020 (`tsconfig.json`); this raises only what the
    // TEST runtime actually provides.
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"],
      "@types/*": ["./src/foundation/contracts/*"],
      "@ui/*": ["./src/components/*"],
      "@checks/*": ["./scripts/check/*"],
      "@tests/*": ["./tests/*"]
    }
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "scripts/**/*.test.ts",
    "scripts/**/*.test.tsx",
    "src/foundation/contracts/ambient/stylesheets",
    "scripts/check/automation/tests/scripts/environment/index.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
