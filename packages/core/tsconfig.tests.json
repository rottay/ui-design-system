{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "rootDir": ".",
    // Declaration correction, not a capability widening: the suites run on a
    // Node/jsdom runtime that already ships the full ES2021 `Intl` surface
    // (`Intl.ListFormat`), while the inherited ES2020 `lib` under-reported it --
    // so a formatter test could exercise an API the checker denied existed.
    // Production stays on ES2020 (`tsconfig.json`); this raises only what the
    // TEST runtime actually provides.
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"],
      "@types/*": ["./src/foundation/contracts/*"],
      "@ui/*": ["./src/components/*"],
      "@checks/*": ["./scripts/check/*"],
      "@tests/*": ["./tests/*"],
      // The consumer fixture (tests/integration/consumer) is authored against
      // the PACKAGE NAME, the way an application authors it. Inside the package
      // the same three names resolve to the sources the published entrypoints
      // are built from, so `typecheck:tests` reads the fixture against the real
      // signatures instead of an unresolved module.
      "@rottay/design-system": ["./src/index.ts"],
      "@rottay/design-system/server": ["./src/entrypoints/server/index.ts"],
      "@rottay/design-system/icons": ["./src/entrypoints/icons/index.ts"]
    }
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "scripts/**/*.test.ts",
    "scripts/**/*.test.tsx",
    "src/foundation/contracts/ambient/stylesheets",
    "scripts/check/automation/tests/scripts/environment/index.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
