{
  "name": "@rottay/showroom",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --port 7001",
    "dev:turbopack": "next dev --turbopack --port 7001",
    "build": "next build --webpack",
    "start": "next start --port 7001",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test:visual": "playwright test e2e/visual --config playwright.visual.config.ts",
    "test:visual:approve": "playwright test e2e/visual --config playwright.visual.config.ts --update-snapshots",
    "test:whitelabel": "playwright test e2e/whitelabel --config playwright.visual.config.ts",
    "test:responsive": "playwright test e2e/responsive --config playwright.visual.config.ts",
    "test:gates": "playwright test --config playwright.visual.config.ts",
    "design:cards": "node scripts/design-cards/generate.mjs",
    "design:validate": "node scripts/design-cards/validate.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@rottay/design-system": "workspace:*",
    "antd": "^5.29.3",
    "d3": "^7.9.0",
    "framer-motion": "^12.38.0",
    "geist": "^1.7.0",
    "lucide-react": "^0.563.0",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/d3": "^7.4.3",
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
