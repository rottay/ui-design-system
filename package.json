{
  "name": "designsystem-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=design-system-dashboard",
    "build": "npm run build --workspace=@es-rottay/designsystem-core",
    "build:all": "npm run build --workspaces",
    "dev:core": "npm run dev --workspace=@es-rottay/designsystem-core",
    "preview": "npm run preview --workspace=design-system-dashboard",
    "storybook": "npm run storybook --workspace=@es-rottay/designsystem-core",
    "build-storybook": "npm run build-storybook --workspace=@es-rottay/designsystem-core",
    "typecheck": "npm run typecheck --workspaces",
    "typecheck:core": "npm run typecheck --workspace=@es-rottay/designsystem-core",
    "typecheck:dashboard": "npm run typecheck --workspace=design-system-dashboard",
    "next:free": "kill-port 3000 && kill-port 6006 && kill-port 6007"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "kill-port": "^2.0.1"
  }
}
