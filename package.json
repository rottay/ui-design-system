{
  "name": "@rottay/design-system",
  "version": "2.19.36",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rottay/ui-design-system.git"
  },
  "homepage": "https://github.com/rottay/ui-design-system#readme",
  "bugs": "https://github.com/rottay/ui-design-system/issues",
  "sideEffects": [
    "*.css"
  ],
  "main": "./packages/core/dist/index.cjs",
  "module": "./packages/core/dist/index.js",
  "types": "./packages/core/dist/index.d.ts",
  "files": [
    "packages/core/dist",
    "packages/core/dist/styles.css",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./packages/core/dist/index.d.ts",
      "import": "./packages/core/dist/index.js",
      "require": "./packages/core/dist/index.cjs"
    },
    "./server": {
      "types": "./packages/core/dist/server.d.ts",
      "import": "./packages/core/dist/server.js",
      "require": "./packages/core/dist/server.cjs"
    },
    "./styles": "./packages/core/dist/styles.css",
    "./styles.css": "./packages/core/dist/styles.css",
    "./styles/default": "./packages/core/dist/rottay.css",
    "./styles/bithire": "./packages/core/dist/bithire.css",
    "./styles/evnto": "./packages/core/dist/evnto.css",
    "./styles/rottay": "./packages/core/dist/rottay.css",
    "./styles/modern": "./packages/core/dist/modern-engine.css"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @rottay/design-system-showroom run dev",
    "dev:core": "pnpm --filter @rottay/design-system run dev",
    "lint": "pnpm --filter @rottay/design-system run lint && pnpm --filter @rottay/showroom run lint",
    "build": "pnpm --filter @rottay/design-system run build",
    "build:all": "pnpm -r run build",
    "storybook": "pnpm --filter @rottay/design-system run storybook",
    "build-storybook": "pnpm --filter @rottay/design-system run build-storybook",
    "test": "pnpm --filter @rottay/design-system run test",
    "test:coverage": "pnpm --filter @rottay/design-system run test:coverage",
    "typecheck": "pnpm --filter @rottay/design-system run build && pnpm -r run typecheck",
    "typecheck:core": "pnpm --filter @rottay/design-system run typecheck",
    "typecheck:tests": "pnpm --filter @rottay/design-system run typecheck:tests && pnpm --filter @rottay/showroom run typecheck:tests",
    "verify:core": "pnpm --filter @rottay/design-system run engine-audit:check && pnpm --filter @rottay/design-system run test:scripts && pnpm --filter @rottay/design-system run typecheck && pnpm --filter @rottay/design-system exec vitest run && pnpm --filter @rottay/design-system run build && pnpm --filter @rottay/design-system run build-storybook",
    "next:free": "kill-port 3000 && kill-port 6006 && kill-port 6007",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "visual:test": "pnpm --filter @rottay/showroom run test:visual",
    "visual:approve": "pnpm --filter @rottay/showroom run test:visual:approve",
    "whitelabel:test": "pnpm --filter @rottay/showroom run test:whitelabel",
    "roadmap:status": "node scripts/maintain/roadmap/status/index.mjs status",
    "roadmap:test": "node --test scripts/maintain/roadmap/status/index.test.mjs",
    "roadmap:check": "pnpm roadmap:test && node scripts/maintain/roadmap/status/index.mjs check",
    "roadmap:commercial": "node scripts/maintain/roadmap/commercial-status/index.mjs status",
    "roadmap:commercial:check": "node scripts/maintain/roadmap/commercial-status/index.mjs check",
    "motion-contracts:check": "node packages/core/scripts/evidence/cra-12-motion-governance/index.mjs",
    "adaptive-contracts:generate": "pnpm --filter @rottay/design-system run adaptive-contracts:generate",
    "adaptive-contracts:check": "pnpm --filter @rottay/design-system run adaptive-contracts:check",
    "adaptive-contracts:gate": "pnpm --filter @rottay/design-system run adaptive-contracts:gate",
    "adaptive-contracts:test": "pnpm --filter @rottay/design-system run adaptive-contracts:test",
    "dependency:honesty": "pnpm run motion-contracts:check && node scripts/check/dependencies/index.mjs check --require-apps",
    "dependency:contract:sync": "node scripts/check/dependencies/index.mjs contract",
    "dependency:honesty:apps": "node scripts/check/dependencies/index.mjs apps --require-apps",
    "dependency:honesty:test": "node --test scripts/check/dependencies/index.test.mjs",
    "effects:provenance": "node scripts/check/effects/index.mjs",
    "effects:provenance:test": "node --test scripts/check/effects/index.test.mjs",
    "icons:generate": "pnpm --filter @rottay/design-system run icons:generate",
    "icons:check": "pnpm --filter @rottay/design-system run icons:check"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "kill-port": "^2.0.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "apca-w3": "^0.1.9"
  }
}
