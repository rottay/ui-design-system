{
  "name": "@rottay/design-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@rottay/design-system-showroom",
    "dev:core": "npm run dev --workspace=@rottay/design-system",
    "build": "npm run build --workspace=@rottay/design-system",
    "build:all": "npm run build --workspaces",
    "storybook": "npm run storybook --workspace=@rottay/design-system",
    "build-storybook": "npm run build-storybook --workspace=@rottay/design-system",
    "test": "npm run test --workspace=@rottay/design-system",
    "typecheck": "npm run typecheck --workspaces",
    "typecheck:core": "npm run typecheck --workspace=@rottay/design-system",
    "next:free": "kill-port 3000 && kill-port 6006 && kill-port 6007"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "kill-port": "^2.0.1"
  }
}
